    buy_x = random.randint(X+5, X+60)
    buy_y = random.randint(Y+5, Y+20)
    pyautogui.moveTo(buy_x, buy_y, 0.01)
    time.sleep(0.05)
    quick_click()
    print("  🛒 Купить")
    time.sleep(0.12)
    pyautogui.press('esc')
    print("  🔚 ESC")
    time.sleep(1)
