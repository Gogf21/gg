def exit_check():
    global WORKING
    while WORKING:
        if keyboard.is_pressed("f1"):
            WORKING = False
            break
        time.sleep(0.01)

# ============ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ============

def analyze_price(name, limit, result, steps_scrolled, current_scroll_y):
    """Проверяет цену: купить, скроллить или сбросить."""
    price, click_x, click_y = result
    print(f"  📋 Цена: {price} (лимит {limit})")
    
    if price <= limit:
        buy_full_process(click_x, click_y)
        print(f"🎉 КУПИЛ {name} за {price}!")
        return "bought", steps_scrolled, current_scroll_y
    
    print(f"  ❌ {price} > {limit}")
    if steps_scrolled < 4:
        new_y = scroll_sidebar_down(1, current_scroll_y)
        return "scroll", steps_scrolled + 1, new_y
    else:
        initAuction(name)
        print(f"  🔄 Сброс позиции")
        return "reset", 0, SCROLLBAR_Y


def process_result(name, limit, result, steps_scrolled, current_scroll_y, empty_count):
    """Обрабатывает любой результат find_first_price."""
    
    if result not in ["empty", "garbage", None]:
        action, steps, y = analyze_price(name, limit, result, steps_scrolled, current_scroll_y)
        return action, steps, y, 0
    
    elif result in ("empty", "garbage"):
        empty_count += 1
        print(f"  📭 {empty_count}/6")
        if empty_count >= 6:
            return "restart", steps_scrolled, current_scroll_y, empty_count
        new_y = scroll_sidebar_down(1, current_scroll_y)
        return "scroll", steps_scrolled + 1, new_y, empty_count
    
    elif result is None:
        print(f"  ⚠️ Ошибка")
        new_y = refresh_and_scroll_to_position(steps_scrolled)
        return "continue", steps_scrolled, new_y, 0


def search_and_buy(name, limit):
    """Первичный поиск предмета."""
    initAuction(name)
    return _auction_loop(name, limit, 0, SCROLLBAR_Y)


def monitor_auction(name, limit, saved_steps):
    """Мониторинг с сохранённой позиции."""
    current_scroll_y = refresh_and_scroll_to_position(saved_steps)
    return _auction_loop(name, limit, saved_steps, current_scroll_y)


def _auction_loop(name, limit, steps_scrolled, current_scroll_y):
    """Общий цикл аукциона."""
    empty_count = 0
    
    while WORKING:
        if not is_life_check_area_visible():
            initAuction(name)
            print("  🚨 Life check! Переоткрываю...")
            steps_scrolled = 0
            current_scroll_y = SCROLLBAR_Y
            empty_count = 0
            time.sleep(0.3)
            continue
        
        rgb, _ = get_screenshot()
        result = find_first_price(rgb)
        
        action, steps_scrolled, current_scroll_y, empty_count = \
            process_result(name, limit, result, steps_scrolled, current_scroll_y, empty_count)
        
        if action == "bought":
            return True, steps_scrolled
        elif action == "restart":
            return False, 0
        
        time.sleep(0.03)


# ============ MAIN ============

def main():
    global WORKING
    print("=" * 50)
    print("⚡ БОТ STALCRAFT ⚡")
    print("F1 - СТОП")
    print("=" * 50)
    
    items = load_items()
    if not items:
        cnt = int(input('Сколько предметов: '))
        for i in range(cnt):
            name = input(f'Предмет {i+1}: ')
            price = int(input(f'Лимит: '))
            items.append([name, price])
        save_items(items)
    
    time.sleep(3)
    initAuction()
    Thread(target=exit_check, daemon=True).start()
    
    optimal_scroll = {}
    
    # Первичный поиск
    print("\n========== ПЕРВИЧНЫЙ ПОИСК ==========")
    for name, limit in items:
        if not WORKING:
            break
        while WORKING:
            success, steps = search_and_buy(name, limit)
            if success:
                print(f"\n✅ {name} КУПЛЕН! Скорлл: {steps}\n")
                optimal_scroll[name] = steps
                break
            time.sleep(1)
    
    # Бесконечный цикл
    print("\n========== БЕСКОНЕЧНЫЙ ЦИКЛ ==========")
    print(f"📌 Позиции: {optimal_scroll}")
    
    while WORKING:
        for name, limit in items:
            if not WORKING:
                break
            steps = optimal_scroll.get(name, 0)
            print(f"\n🔄 {name} (скролл: {steps})")
            monitor_auction(name, limit, steps)
        time.sleep(0.05)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nСтоп")
    except Exception as e:
        print(f"Ошибка: {e}")
        traceback.print_exc()
