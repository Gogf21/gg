# ============ ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ============

def analyze_price(name, limit, result, steps_scrolled, current_scroll_y):
    """Проверяет цену: купить или обновить позицию."""
    price, click_x, click_y = result
    print(f"  📋 Цена: {price} (лимит {limit})")
    
    # Защита: если цена >= 1 000 000 — что-то пошло не так, рестарт аукциона
    if price >= 1000000:
        print(f"  🚨 Цена {price} >= 1кк! Рестарт аукциона...")
        pyautogui.press('esc')
        time.sleep(0.2)
        initAuction(name)
        return "life_check", 0, SCROLLBAR_Y
    
    if price <= limit:
        buy_full_process(click_x, click_y)
        print(f"🎉 КУПИЛ {name} за {price}!")
        return "bought", 0, SCROLLBAR_Y
    
    print(f"  ❌ {price} > {limit}, обновляю...")
    new_y = refresh_and_scroll_to_position(FIXED_STEPS)
    return "refresh", 0, new_y


def process_result(name, limit, result, steps_scrolled, current_scroll_y, empty_count):
    """Обрабатывает любой результат find_first_price."""
    
    if not is_life_check_area_visible():
        initAuction(name)
        print("  🚨 Life check! Переоткрываю...")
        return "life_check", 0, SCROLLBAR_Y, 0
    
    if result not in ["empty", "garbage", None]:
        return analyze_price(name, limit, result, steps_scrolled, current_scroll_y) + (0,)
    
    elif result in ("empty", "garbage"):
        new_y = refresh_and_scroll_to_position(FIXED_STEPS)
        return "refresh", 0, new_y, 0
    
    elif result is None:
        print(f"  ⚠️ Ошибка")
        new_y = refresh_and_scroll_to_position(FIXED_STEPS)
        return "continue", 0, new_y, 0


def auction_cycle(name, limit, saved_steps=0, is_first_search=False):
    """Универсальный цикл аукциона."""
    
    if is_first_search:
        initAuction(name)
    else:
        refresh_and_scroll_to_position(FIXED_STEPS)
    
    while WORKING:
        rgb, _ = get_screenshot()
        result = find_first_price(rgb)
        
        action, steps_scrolled, current_scroll_y, empty_count = \
            process_result(name, limit, result, 0, SCROLLBAR_Y, 0)
        
        if action == "bought":
            return True, FIXED_STEPS
        elif action == "life_check":
            time.sleep(0.3)
            continue
        
        time.sleep(0.03)
    
    return False, 0


