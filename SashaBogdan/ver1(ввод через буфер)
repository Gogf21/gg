def main():
    global WORKING
    print("=" * 50)
    print("⚡ БОТ STALCRAFT ⚡")
    print("F1 - СТОП")
    print("=" * 50)
    
    items = load_items()
    if not items:
        cnt = int(input('Сколько предметов: '))
        for i in range(cnt):
            name = input(f'Предмет {i+1}: ')
            items.append([name, int(input(f'Лимит: '))])
        save_items(items)
    
    print("старт через 3")
    time.sleep(3)
    Thread(target=exit_check, daemon=True).start()
    
    optimal_scroll = {}
    
    print("\n========== ПЕРВИЧНЫЙ ПОИСК ==========")
    for name, limit in items:
        if not WORKING: break
        while WORKING:
            success, steps = auction_cycle(name, limit, is_first_search=True)
            if success:
                print(f"PP\n✅ {name} КУПЛЕН! Скорлл: {steps}\n")
                optimal_scroll[name] = steps
                break
            time.sleep(1)
    
    print("\n========== БЕСКОНЕЧНЫЙ ЦИКЛ ==========")
    while WORKING:
        for name, limit in items:
            if not WORKING: break
            steps = optimal_scroll.get(name, 0)
            print(f"\n🔄 {name} (скролл: {steps})")
            auction_cycle(name, limit, steps)
        time.sleep(0.05)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nСтоп")
