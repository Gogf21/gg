def save_items(items):
    with open(ITEMS_FILE, "w", encoding="utf-8") as f:
        for name, price in items:
            f.write(f"{name}|{price}\n")
    print(f"💾 Сохранено: {len(items)}")

def load_items():
    items = []
    if os.path.exists(ITEMS_FILE):
        with open(ITEMS_FILE, "r", encoding="utf-8-sig") as f:  # utf-8-sig для удаления BOM
            for line in f:
                parts = line.strip().split("|")
                if len(parts) == 2:
                    name = parts[0].strip()  # Убираем лишние пробелы
                    items.append([name, int(parts[1])])
        print(f"📂 Загружено: {len(items)}")
        for name, price in items:
            print(f"  - {name}: {price}")
    return items

def quick_click():
    pyautogui.click()
    time.sleep(0.001)

def imageRecognitionFast(template, screenshot_gray):
    result = cv2.matchTemplate(screenshot_gray, template, cv2.TM_SQDIFF_NORMED)
    mn, _, mnLoc, _ = cv2.minMaxLoc(result)
    return mnLoc

def get_screenshot():
    screenshot = sct.grab(monitor)
    screenshot_rgb = np.array(screenshot)
    screenshot_gray = cv2.cvtColor(screenshot_rgb, cv2.COLOR_BGR2GRAY)
    return screenshot_rgb, screenshot_gray

def type_from_clipboard(text):
    """
    Ввод текста через буфер обмена
    Работает с любым языком и не зависит от раскладки клавиатуры
    """
    # Сохраняем текущее содержимое буфера
    old_clipboard = pyperclip.paste()
    
    # Копируем нужный текст
    pyperclip.copy(text)
    time.sleep(0.03)
    
    # Вставляем
    pyautogui.hotkey('ctrl', 'v')
    time.sleep(0.05)
    
    # Восстанавливаем старый буфер (опционально)
    pyperclip.copy(old_clipboard)

